# ---- Required ----
# Supabase → Connect → Transaction pooler (port 6543), password filled in
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
# Optional. Signs login sessions; if empty, a key is generated once and kept in the database.
SESSION_SECRET=
# One-time code for the first-run setup screen (/setup). Remove after setup.
SETUP_TOKEN=

# ---- File storage (prescription PDFs, scans, receipts) ----
# Supabase → Project Settings → API. Without these, files are stored in the database.
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_SECRET_KEY=

# ---- AI: voice-to-Rx and photo intake (OpenAI) ----
OPENAI_API_KEY=
AI_MODEL=gpt-5-nano

# ---- WhatsApp auto-send via AiSensy (optional; falls back to wa.me links) ----
AISENSY_API_KEY=
AISENSY_RX_CAMPAIGN=arogya_rx_prescription
AISENSY_REMINDER_CAMPAIGN=arogya_rx_followup
AISENSY_BOOKING_CAMPAIGN=arogya_rx_booking

# ---- One-time import from the old DoctorAppointmentForm database ----
OLD_DATABASE_URL=

# Public URL of this app (used in WhatsApp links)
APP_URL=https://arogya-rx-dr-deepak.vercel.app
